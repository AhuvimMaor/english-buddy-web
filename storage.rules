rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function callData(callId) {
      return firestore.get(/databases/(default)/documents/calls/$(callId)).data;
    }
    function isParticipant(callId) {
      return request.auth != null &&
        (callData(callId).callerId == request.auth.uid || callData(callId).calleeId == request.auth.uid);
    }

    // Single-file recording (legacy / fallback): recordings/{callId}/{userId}.{ext}
    // The file name is "<uid>.<ext>", so the owner is the part before the dot.
    match /recordings/{callId}/{fileName} {
      allow write: if request.auth != null &&
        fileName.split('\\.')[0] == request.auth.uid &&
        isParticipant(callId) &&
        request.resource.size < 100 * 1024 * 1024;
      allow read: if isParticipant(callId);
    }
    // Chunked recording slices: recordings/{callId}/{userId}/chunk-NNNNNN.{ext}
    match /recordings/{callId}/{userId}/{chunkFile} {
      allow write: if request.auth != null && request.auth.uid == userId &&
        isParticipant(callId) &&
        request.resource.size < 25 * 1024 * 1024;
      allow read: if isParticipant(callId);
    }
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow read: if true;
    }
  }
}
