rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(call) {
      return signedIn() &&
        (call.callerId == request.auth.uid || call.calleeId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      // Call stats are maintained by the server only.
      allow update: if signedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['callCount', 'totalCallMinutes']);
    }

    match /calls/{callId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedIn() &&
        request.resource.data.callerId == request.auth.uid &&
        request.resource.data.calleeId is string &&
        request.resource.data.calleeId != request.auth.uid &&
        request.resource.data.status == 'ringing' &&
        request.resource.data.analysisStatus == 'pending';
      // Participants may change call state and their OWN recording metadata only.
      // analysisStatus/transcription belong to the server (admin SDK bypasses rules).
      allow update: if isParticipant(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'startedAt', 'endedAt', 'durationSeconds',
          'recordingChunkPrefix_' + request.auth.uid,
          'recordingChunkCount_' + request.auth.uid,
          'recordingMime_' + request.auth.uid,
          'recording_' + request.auth.uid
        ]);

      match /signaling/{sigId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow create: if isParticipant(get(/databases/$(database)/documents/calls/$(callId)).data) &&
          request.resource.data.from == request.auth.uid;
      }

      // Live captions are written by /api/live-caption (admin SDK) only.
      match /captions/{captionId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/calls/$(callId)).data);
        allow write: if false;
      }
    }

    match /reports/{reportId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
