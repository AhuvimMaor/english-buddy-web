# Client (public) Firebase config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only
OPENAI_API_KEY=
# Raw service-account JSON or its base64
FIREBASE_SERVICE_ACCOUNT_KEY=
# Required for /api/debug and for force/reprocess on /api/analyze. Use a long random string.
INTERNAL_API_SECRET=

# Optional: your own TURN server (recommended for production). Falls back to the free public relay.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Local development against the Firebase emulators
NEXT_PUBLIC_USE_EMULATORS=false
